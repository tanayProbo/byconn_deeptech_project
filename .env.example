# ── Required ──────────────────────────────────────────────────────────────────
# OpenAI API key — needed for entity extraction and visual agent
OPENAI_API_KEY=sk-your-key-here

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/byconnx

# ── Qdrant Vector DB ───────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ── Neo4j Graph DB ─────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ── ClickHouse Analytics DB ───────────────────────────────────────────────────
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=byconnx

# ── Optional ───────────────────────────────────────────────────────────────────
# Uncomment to use a specific OpenAI model (default: gpt-4o)
# OPENAI_MODEL=gpt-4o-mini
