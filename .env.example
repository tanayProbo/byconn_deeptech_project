# ---------------------------------------------------------------------------
# BYCONN-X example configuration.
#
# Copy to `.env` and fill in what you need:
#     cp .env.example .env
#
# Every value is OPTIONAL. Anything omitted falls back to a local default, so
# the service starts even with no configuration at all (in a degraded state if
# the databases are unreachable).
#
#   ?  = uncomment exactly one LLM block below
#
# NOTE: values are intentionally left blank. Do not commit a filled-in `.env`.
# ===========================================================================

# ===========================================================================
# LLM PROVIDER - pick one of the three blocks
# ===========================================================================

# --- (1) LOCAL / FREE: Ollama  -------------------------------------------
# Fully offline and free. Any OpenAI-compatible server works the same way.
#   ollama pull llama3.2        # text extraction
#   ollama pull llava           # screenshots (visual agent)
#   ollama serve                # serves http://localhost:11434/v1
# OPENAI_API_KEY=ollama is the switch: it implies the local base URL, so
# OPENAI_API_BASE can be omitted entirely.
#
# OPENAI_API_KEY=ollama
# OPENAI_API_BASE=http://localhost:11434/v1
# MODEL_NAME=llama3.2
# VISION_MODEL_NAME=llava

# --- (2) FREE TIER: Groq -------------------------------------------------
# Generous free tier, no card needed. OpenAI-compatible.
#   export GROQ_API_KEY=gsk_...
#   MODEL_NAME=llama-3.3-70b-versatile
#   VISION_MODEL_NAME=meta-llama/llama-4-scout-17b-16e-instruct
#
# GROQ_API_KEY=
# MODEL_NAME=llama-3.3-70b-versatile

# --- (3) HOSTED: OpenAI or Gemini ----------------------------------------
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-3.8-flash

# Any other OpenAI-compatible endpoint (vLLM, LM Studio, llama.cpp, TGI):
# set OPENAI_API_BASE to its /v1 URL. If the server ignores auth, setting
# only OPENAI_API_BASE is enough - a placeholder key is supplied automatically.
# OPENAI_API_BASE=http://localhost:8000/v1

# Force a specific backend: openai | groq | gemini
# LLM_PROVIDER=auto

# LLM_TEMPERATURE=0.0
# LLM_MAX_RETRIES=2
# LLM_MAX_INPUT_TOKENS=6000

# --- Embeddings (vector search) -------------------------------------------
# Provider order: sentence-transformers (local) then OpenAI. With neither
# available the pipeline still crawls and stores pages but skips vector
# indexing, and /api/v1/health reports "embeddings": "disabled".
# Install the local model with:  pip install -e ".[local-embeddings]"
# EMBEDDING_PROVIDER=auto
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# EMBEDDING_DIMENSIONS=384      # must match your Qdrant collection

# ===========================================================================
# Datastores
# ===========================================================================

# --- PostgreSQL -----------------------------------------------------------
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/byconnx
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=byconnx

# --- Qdrant ---------------------------------------------------------------
# QDRANT_URL=http://localhost:6333
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
# QDRANT_HTTPS=false
# QDRANT_API_KEY=

# --- Neo4j ----------------------------------------------------------------
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=password
# NEO4J_DATABASE=

# --- ClickHouse (reserved) ------------------------------------------------
# Retained from the original configuration. The ClickHouse sink was dropped in
# favour of PostgreSQL + structured logging, so these are currently unused.
# CLICKHOUSE_HOST=localhost
# CLICKHOUSE_PORT=8123
# CLICKHOUSE_DB=byconnx

# ===========================================================================
# Server & crawler limits
# ===========================================================================
# HOST=0.0.0.0
# PORT=8000
# LOG_LEVEL=info
# STARTUP_CONNECT_TIMEOUT=10      # seconds before a dependency is declared down
# PIPELINE_STEP_TIMEOUT=30        # seconds before a single pipeline step gives up
# CRAWL_CONCURRENCY=2             # simultaneous crawls
# CRAWL_PAGE_CONCURRENCY=3        # browser workers per crawl
# CRAWL_MAX_PAGES=50              # hard page cap per crawl
# CRAWL_HEADLESS=true
# CRAWL_DEDUPLICATE=true          # skip near-duplicate pages before embedding
# API_INTELLIGENCE=true           # sniff XHR/fetch traffic into an OpenAPI spec
# OUTPUT_DIR=byconn_output
